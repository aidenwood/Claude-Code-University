---
interface Props {
  command: string;
  breakdown?: { segment: string; explanation: string }[];
}

const { command, breakdown } = Astro.props;
const id = `copy-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="group relative my-4 rounded-xl border border-border bg-text p-4">
  <div class="flex items-center justify-between gap-4">
    <code class="block overflow-x-auto text-sm font-mono text-surface whitespace-pre">{command}</code>
    <button
      data-copy-target={id}
      data-copy-text={command}
      class="shrink-0 rounded-lg border border-white/20 px-3 py-1.5 text-xs font-medium text-white/70 transition-all hover:border-purple hover:text-purple cursor-pointer"
      aria-label="Copy to clipboard"
    >
      Copy
    </button>
  </div>

  {breakdown && breakdown.length > 0 && (
    <div class="mt-3 border-t border-white/10 pt-3 space-y-1.5">
      {breakdown.map((item, i) => {
        const colors = ['text-purple-light', 'text-[#00D3DD]', 'text-[#22c55e]', 'text-[#f59e0b]', 'text-[#f472b6]'];
        const color = colors[i % colors.length];
        return (
          <div class="flex items-start gap-2 text-xs">
            <code class={`font-mono font-semibold ${color} shrink-0`}>{item.segment}</code>
            <span class="text-white/50">{item.explanation}</span>
          </div>
        );
      })}
    </div>
  )}
</div>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-copy-text]') as HTMLElement;
    if (!btn) return;
    const text = btn.getAttribute('data-copy-text') || '';
    navigator.clipboard.writeText(text).then(() => {
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('border-purple', 'text-purple');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('border-purple', 'text-purple');
      }, 2000);
    });
  });
</script>
