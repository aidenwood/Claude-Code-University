---
import MainLayout from '../../layouts/MainLayout.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import BeginnerNote from '../../components/BeginnerNote.astro';
import ThisNotThat from '../../components/ThisNotThat.astro';
---

<MainLayout
  title="IT & Systems Admin Training"
  subtitle="Claude Code for IT — automation scripts, server configs, documentation, and incident management"
>
  <!-- What Claude Can Do For IT -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">What Claude Can Do For IT</h2>
    <p class="text-text-secondary mb-4">
      Claude automates the repetitive work that burns out IT teams. Write automation scripts, generate config files, parse logs, document infrastructure, and manage incidents — all in minutes instead of hours.
    </p>
    <ul class="space-y-2 text-text-secondary">
      <li class="flex gap-3">
        <span class="text-purple font-bold">→</span>
        <span><strong>Automation scripts:</strong> Bash, Python, PowerShell — any language, any task</span>
      </li>
      <li class="flex gap-3">
        <span class="text-purple font-bold">→</span>
        <span><strong>Config generation:</strong> nginx, Docker, Kubernetes, database configs with defaults</span>
      </li>
      <li class="flex gap-3">
        <span class="text-purple font-bold">→</span>
        <span><strong>Log analysis:</strong> Parse gigabytes of logs, find errors, spot patterns, identify threats</span>
      </li>
      <li class="flex gap-3">
        <span class="text-purple font-bold">→</span>
        <span><strong>Infrastructure docs:</strong> Generate architecture diagrams, runbooks, deployment procedures</span>
      </li>
      <li class="flex gap-3">
        <span class="text-purple font-bold">→</span>
        <span><strong>Incident response:</strong> Parse notes, organize timelines, root cause analysis, remediation steps</span>
      </li>
      <li class="flex gap-3">
        <span class="text-purple font-bold">→</span>
        <span><strong>Security audits:</strong> Check for exposed secrets, verify permissions, scan for vulnerabilities</span>
      </li>
    </ul>
  </div>

  <!-- Industry Adoption Stats -->
  <div class="rounded-xl border border-purple/20 bg-purple-50 p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-purple">Industry adoption</p>
    <p class="mt-2 text-sm text-text-secondary">
      Infrastructure-as-Code is now standard for 80%+ of cloud deployments. Automated security audit scripts reduce manual compliance checking by 90%. AI log analysis detects anomalies 24-48 hours earlier than human operators. Runbook automation cuts incident resolution time by 40%.
    </p>
  </div>

  <!-- Automation Scripts -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Automation Scripts</h2>
    <p class="text-text-secondary mb-6">
      Write scripts in any language. Claude handles logic, error checking, and integrations. Just describe what you want — the script is ready to test.
    </p>

    <div class="space-y-4">
      <CopyBlock
        command="Write a bash script that checks disk usage on all mounted volumes, sends a Slack webhook alert if any volume is over 85% full, and logs results to /var/log/disk-check.log with timestamps"
        breakdown={[
          { segment: "checks disk usage", explanation: "uses df to check all mounts" },
          { segment: "over 85% full", explanation: "sets threshold for alert" },
          { segment: "Slack webhook alert", explanation: "posts to your monitoring channel" },
          { segment: "logs with timestamps", explanation: "tracks every check for audit" }
        ]}
      />

      <CopyBlock
        command="Create a Python script that reads our user-accounts.csv, compares against active-directory-export.csv, and flags accounts that exist in AD but not in our records (potential orphan accounts)"
        breakdown={[
          { segment: "reads user-accounts.csv", explanation: "your current user database" },
          { segment: "compares against AD export", explanation: "active directory authoritative source" },
          { segment: "flags orphan accounts", explanation: "finds accounts not in your records" },
          { segment: "potential security risk", explanation: "inactive accounts that need removal" }
        ]}
      />
    </div>

    <BeginnerNote>
      Claude writes working scripts — just test in staging first. Include specific file paths, thresholds, and alert destinations so Claude gets the details right.
    </BeginnerNote>
  </div>

  <!-- Server & Infrastructure Configs -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Server & Infrastructure Configs</h2>
    <p class="text-text-secondary mb-6">
      Generate production-ready configs for nginx, Docker, Kubernetes, and more. Claude adds security headers, rate limiting, health checks, and best practices by default.
    </p>

    <div class="space-y-4">
      <CopyBlock
        command="Generate an nginx config for reverse-proxying our internal apps: app1 on port 3000 at app1.internal.company.com, app2 on port 8080 at app2.internal.company.com. Include SSL, rate limiting, and security headers"
        breakdown={[
          { segment: "reverse-proxy", explanation: "routes external requests to internal apps" },
          { segment: "app1:3000, app2:8080", explanation: "internal service addresses" },
          { segment: "SSL", explanation: "HTTPS encryption for security" },
          { segment: "rate limiting + headers", explanation: "DoS protection and security hardening" }
        ]}
      />

      <CopyBlock
        command="Read our current docker-compose.yml and add a Redis cache service, connect it to the existing app service, add health checks, and set a 512MB memory limit"
        breakdown={[
          { segment: "add Redis service", explanation: "new cache layer for performance" },
          { segment: "connect to app", explanation: "sets correct network and env vars" },
          { segment: "health checks", explanation: "Docker monitors service readiness" },
          { segment: "512MB limit", explanation: "resource constraint for cost control" }
        ]}
      />
    </div>

    <BeginnerNote>
      Share your current config files — Claude reads them and outputs updated versions with minimal changes, keeping your existing setup intact.
    </BeginnerNote>
  </div>

  <!-- Log Analysis & Troubleshooting -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Log Analysis & Troubleshooting</h2>
    <p class="text-text-secondary mb-6">
      Parse massive log files in seconds. Claude finds errors, identifies patterns, spots correlations with deployments, and flags security incidents.
    </p>

    <div class="space-y-4">
      <CopyBlock
        command="Read error-log.txt — find the most common error types, show frequency over time, and identify any patterns (time of day, specific endpoints, user agents)"
        breakdown={[
          { segment: "error types", explanation: "groups by error message or code" },
          { segment: "frequency over time", explanation: "shows when errors spike" },
          { segment: "patterns by endpoint", explanation: "finds which routes fail most" },
          { segment: "correlate with time", explanation: "reveals if errors cluster at certain hours" }
        ]}
      />

      <CopyBlock
        command="Analyze auth-failures.log for the last 7 days — identify IP addresses with more than 10 failed attempts, check for brute-force patterns, and generate a blocklist"
        breakdown={[
          { segment: "IP addresses", explanation: "groups failed logins by source" },
          { segment: "more than 10 attempts", explanation: "threshold for suspicious activity" },
          { segment: "brute-force patterns", explanation: "rapid-fire attempts from single IP" },
          { segment: "blocklist output", explanation: "IPs ready for firewall rules" }
        ]}
      />
    </div>

    <BeginnerNote>
      Large logs (100MB+) work fine — Claude streams analysis and highlights the critical bits. Include date ranges so Claude filters by time.
    </BeginnerNote>
  </div>

  <!-- Infrastructure Documentation -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Infrastructure Documentation</h2>
    <p class="text-text-secondary mb-6">
      Turn config files and deployment scripts into clean documentation. Claude generates architecture diagrams, runbooks, and deployment procedures from your actual code.
    </p>

    <div class="space-y-4">
      <CopyBlock
        command="Read our infrastructure setup in configs/ and docker-compose files — generate a system architecture document showing services, ports, dependencies, and data flow"
        breakdown={[
          { segment: "read configs/ folder", explanation: "gathers all infrastructure files" },
          { segment: "system architecture doc", explanation: "visual overview of the whole setup" },
          { segment: "services + ports", explanation: "what runs where" },
          { segment: "dependencies + data flow", explanation: "how services talk to each other" }
        ]}
      />

      <CopyBlock
        command="Create a runbook for our deployment process: read deploy.sh and the CI config in .github/workflows/ — document each step, common failure modes, and rollback procedures"
        breakdown={[
          { segment: "read deploy.sh", explanation: "actual deployment script" },
          { segment: "read CI workflow", explanation: "automated pipeline config" },
          { segment: "document each step", explanation: "plain English walkthrough" },
          { segment: "failure modes + rollback", explanation: "what can go wrong and how to fix it" }
        ]}
      />
    </div>

    <BeginnerNote>
      Share your actual scripts and config files — Claude documents what you really run, not theoretical best practices. Runbooks end up in Confluence or your wiki.
    </BeginnerNote>
  </div>

  <!-- This / Not That -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Common Mistakes — Do This Instead</h2>

    <ThisNotThat
      notThis="Write me a backup script"
      notThisDetail="Where? What database? How often? Where does it go?"
      doThis="Write a bash script that backs up the PostgreSQL database at SUPABASE_DB_URL to /backups/ with timestamp naming, retains the last 30 days, uploads to S3 bucket backup-bucket, and sends a Slack notification on success or failure"
      doThisDetail="Claude sees the full picture: database source, retention policy, storage destination, and alerting."
    />

    <ThisNotThat
      notThis="Check the logs"
      notThisDetail="Which logs? Which period? What are you looking for?"
      doThis="Read error-log.txt from the last 24 hours, group errors by type and endpoint, show a timeline of error spikes, and correlate with deploy times from deploy-history.csv"
      doThisDetail="Claude parses, groups, and correlates — you get actionable insights instead of raw lines."
    />

    <ThisNotThat
      notThis="Set up monitoring"
      notThisDetail="Monitoring what? What thresholds? On which services?"
      doThis="Read our docker-compose.yml services, generate a monitoring config for each service with health check endpoints, expected response times, and alert thresholds. Output as a Prometheus/Grafana config"
      doThisDetail="Claude generates configs ready to apply — covers every service with sane defaults."
    />

    <ThisNotThat
      notThis="Document the infrastructure"
      notThisDetail="Which parts? What level of detail? For whom?"
      doThis="Read all config files in infra/, deployment scripts in scripts/, and our current wiki page in docs/architecture.md — create an updated architecture doc showing services, ports, dependencies, and recent changes"
      doThisDetail="Claude reads what you've already written and creates unified documentation."
    />
  </div>

  <!-- Security & Incident Response -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Security & Incident Response</h2>
    <p class="text-text-secondary mb-6">
      Secure your infrastructure and respond to incidents faster. Claude audits for exposed secrets, analyzes incident logs, and generates formal reports.
    </p>

    <div class="space-y-4">
      <CopyBlock
        command="Audit our .env files across all projects in ~/projects/ — check for hardcoded secrets, verify .gitignore includes .env, and flag any .env files that are tracked in git"
        breakdown={[
          { segment: "audit .env files", explanation: "checks all environment files" },
          { segment: "hardcoded secrets", explanation: "finds API keys, tokens, passwords" },
          { segment: "verify .gitignore", explanation: "ensures files aren't tracked in version control" },
          { segment: "flag tracked .env", explanation: "potential exposure in git history" }
        ]}
      />

      <CopyBlock
        command="Read incident-report-template.md and the raw notes in incidents/2026-04-outage.txt — generate a formal incident report with timeline, root cause, impact assessment, and remediation steps"
        breakdown={[
          { segment: "incident notes", explanation: "raw troubleshooting logs" },
          { segment: "timeline", explanation: "when each event occurred" },
          { segment: "root cause", explanation: "what actually broke" },
          { segment: "impact + remediation", explanation: "who was affected and how we fixed it" }
        ]}
      />
    </div>

    <BeginnerNote>
      For incident reports, include timestamps and all troubleshooting notes — Claude organizes chaos into a clear narrative.
    </BeginnerNote>
  </div>

  <!-- Advanced: Infrastructure as Code -->
  <div class="rounded-xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-bold text-text mb-4">Advanced: Infrastructure as Code</h2>
    <p class="text-text-secondary mb-6">
      Automate infrastructure documentation and security audits. Claude generates architecture diagrams from your configs, audits all .env files for exposed secrets, and verifies security best practices across your project ecosystem.
    </p>

    <div class="space-y-4">
      <CopyBlock
        command="Read our docker-compose.yml and all configs in infrastructure/ — generate a system architecture document showing every service, its ports, dependencies, data flow, and health check endpoints. Output as markdown with a mermaid diagram"
        breakdown={[
          { segment: "read docker-compose.yml", explanation: "service definitions and network" },
          { segment: "read all configs", explanation: "gathers infrastructure-as-code files" },
          { segment: "every service, ports, dependencies", explanation: "complete service topology" },
          { segment: "data flow", explanation: "how services communicate" },
          { segment: "health check endpoints", explanation: "monitoring and readiness checks" },
          { segment: "mermaid diagram", explanation: "visual architecture diagram" }
        ]}
      />

      <CopyBlock
        command="Audit all .env files across ~/projects/ — check for hardcoded secrets, verify each project has .env in .gitignore, flag any .env files tracked in git. Output a security report with severity levels and remediation steps"
        breakdown={[
          { segment: "audit .env files", explanation: "checks all environment configurations" },
          { segment: "check for secrets", explanation: "finds API keys, tokens, passwords" },
          { segment: "verify .gitignore", explanation: "ensures .env not tracked in git" },
          { segment: "flag tracked .env", explanation: "potential exposure in version control" },
          { segment: "severity levels", explanation: "critical/high/medium/low risk" },
          { segment: "remediation steps", explanation: "actionable fixes with instructions" }
        ]}
      />
    </div>

    <BeginnerNote>
      Claude writes scripts in any language. Describe what you want in plain English, it builds the automation. Always test in staging first.
    </BeginnerNote>
  </div>

  <!-- Data Security Warning -->
  <div class="my-6 rounded-xl border-2 border-danger/30 bg-danger-light p-5">
    <div class="mb-2 flex items-center gap-2">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-danger text-white text-xs font-bold">!</span>
      <span class="text-sm font-bold uppercase tracking-wide text-danger">Never Share Production Secrets</span>
    </div>
    <p class="text-sm text-text">
      <strong>Never paste production credentials, SSH keys, database connection strings, or API secrets.</strong> Use placeholder values instead. Claude can analyze config structure and logic without seeing real secrets. Replace actual values with PLACEHOLDER, YOUR_TOKEN, or XXX before sharing any code.
    </p>
  </div>

  <!-- Back to Hub -->
  <div class="mt-8 rounded-xl border border-border bg-background-alt p-5 text-center">
    <p class="text-sm text-text-secondary">
      Ready for more? Explore other departments or jump back to the main course.
      <br />
      <a href="/departments" class="font-medium text-purple hover:underline">All departments &rarr;</a>
    </p>
  </div>

  <!-- Elliot's Training Roadmap -->
  <section class="rounded-xl border-2 border-[#1a1a2e]/20 bg-surface p-6 md:p-8" id="elliot-roadmap">
    <div class="flex items-center gap-3 mb-2">
      <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#1a1a2e] text-sm font-bold text-white">EL</span>
      <div>
        <h2 class="text-xl font-bold text-text">Elliot's 30-Day Claude Code Roadmap</h2>
        <p class="text-sm text-text-muted">IT Manager — First month training plan</p>
      </div>
    </div>
    <p class="mt-3 text-text-secondary">
      Daily tasks that build on each other. By the end of month one, you'll have automated the staff onboarding process and built real internal tools with Claude Code.
    </p>

    <!-- Week 1: Foundations -->
    <div class="rounded-xl border border-border bg-background-alt p-5 mt-4">
      <h3 class="font-bold text-lg text-text mb-3">Week 1: Foundations (Days 1–5)</h3>

      <div class="space-y-3">
        <!-- Day 1 -->
        <div class="border-l-4 border-purple pl-4">
          <p class="font-bold text-text"><span class="text-purple">Day 1</span> — Setup & First Conversation</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Complete Module 1 (dev environment setup: Homebrew, Node, Python, Git, GitHub Desktop, Claude Code)</li>
            <li>• Run <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">claude</code> in a test folder, ask it to create a hello world HTML file</li>
            <li>• Read Module 2 (Terminal Survival Kit) — learn <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">ls</code>, <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">cd</code>, <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">pwd</code>, <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">open .</code></li>
          </ul>
          <CopyBlock command="claude" />
          <CopyBlock command="Create a simple HTML page that says 'Hello from Elliot's first Claude project' with some basic styling" />
        </div>

        <!-- Day 2 -->
        <div class="border-l-4 border-[#00D3DD] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#00D3DD]">Day 2</span> — Working With Projects & CLAUDE.md</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Read Module 3 (First Conversation) and Module 4 (Working With Projects)</li>
            <li>• Create a CLAUDE.md in a test project — write your tech stack and preferences</li>
            <li>• Practice pointing Claude at specific files</li>
          </ul>
          <CopyBlock command="Read index.html and add a navigation bar" />
          <CopyBlock command="Read this project and explain what files exist and what each one does" />
        </div>

        <!-- Day 3 -->
        <div class="border-l-4 border-[#22c55e] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#22c55e]">Day 3</span> — Git & GitHub Desktop</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Read Module 7 (GitHub → Netlify Pipeline)</li>
            <li>• Create a GitHub repo via GitHub Desktop for the test project</li>
            <li>• Practice the commit → push cycle</li>
            <li>• Connect the repo to Netlify for auto-deploy</li>
          </ul>
          <CopyBlock command="git add . && git commit -m 'Add navigation bar' && git push" />
        </div>

        <!-- Day 4 -->
        <div class="border-l-4 border-[#f59e0b] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f59e0b]">Day 4</span> — Think Like a Developer</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Read Module 5 (Think Like a Developer — This / Not That)</li>
            <li>• Practice specific prompts vs vague prompts on your test project</li>
            <li>• Read Module 9 (Security & Privacy) — essential for IT</li>
            <li>• Set up a <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">.claudeignore</code> file</li>
          </ul>
          <CopyBlock command="Read the current index.html and add a responsive sidebar navigation. Match the existing CSS class patterns. Don't add external dependencies." />
        </div>

        <!-- Day 5 -->
        <div class="border-l-4 border-[#f472b6] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f472b6]">Day 5</span> — Start the Onboarding Project</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Create a new repo: <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">rebuild-onboarding</code> via GitHub Desktop</li>
            <li>• Tell Claude what the project is: a staff onboarding web app</li>
            <li>• Have Claude read the existing static HTML onboarding files</li>
            <li>• Ask Claude to analyze and propose a better structure</li>
          </ul>
          <CopyBlock command="Read all HTML files in this project. These are our current static staff onboarding pages. Analyze them and propose how to restructure this into a modern, maintainable web app using Astro 5 with Tailwind CSS 4. Don't build yet — just give me the plan." />
        </div>
      </div>
    </div>

    <!-- Week 2: Building -->
    <div class="rounded-xl border border-border bg-background-alt p-5 mt-4">
      <h3 class="font-bold text-lg text-text mb-3">Week 2: Building (Days 6–12)</h3>

      <div class="space-y-3">
        <!-- Day 6 -->
        <div class="border-l-4 border-purple pl-4">
          <p class="font-bold text-text"><span class="text-purple">Day 6</span> — Scaffold the Onboarding App</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Accept/modify Claude's plan from Day 5</li>
            <li>• Have Claude scaffold the Astro project with Tailwind</li>
          </ul>
          <CopyBlock command="Scaffold an Astro 5 project with Tailwind CSS 4. Create the folder structure you proposed. Include a MainLayout with the Rebuild Relief brand colours (navy #001B51 backgrounds, Pacific Blue #47B1CC accents, Inter font). Don't add content yet — just the skeleton." />
        </div>

        <!-- Day 7 -->
        <div class="border-l-4 border-[#00D3DD] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#00D3DD]">Day 7</span> — Migrate Content</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Have Claude read the old static HTML and migrate content into the new structure</li>
          </ul>
          <CopyBlock command="Read the old onboarding pages in old-site/ and migrate all content into the new Astro pages. Keep every piece of information — don't skip anything. Use the new layout and component structure." />
        </div>

        <!-- Day 8 -->
        <div class="border-l-4 border-[#22c55e] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#22c55e]">Day 8</span> — Add Interactivity</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Checklist functionality: staff can tick off completed onboarding steps</li>
            <li>• Progress tracking: show overall completion percentage</li>
          </ul>
          <CopyBlock command="Add a checkbox system to each onboarding step. When a staff member ticks a box, save their progress to localStorage. Show a progress bar at the top of each page showing how many steps are complete out of the total." />
        </div>

        <!-- Day 9 -->
        <div class="border-l-4 border-[#f59e0b] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f59e0b]">Day 9</span> — Multi-Page Flow</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Create a proper onboarding journey with multiple sections</li>
            <li>• Navigation between sections</li>
          </ul>
          <CopyBlock command="Create a multi-step onboarding flow with these sections: 1. Welcome & Company Overview, 2. IT Setup (accounts, equipment, VPN), 3. HR Paperwork (tax, super, emergency contacts), 4. Team Introductions, 5. Tools & Systems Access, 6. Completion. Add prev/next navigation and a sidebar showing all sections with completion status." />
        </div>

        <!-- Day 10 -->
        <div class="border-l-4 border-[#f472b6] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f472b6]">Day 10</span> — Deploy & Test</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Push to GitHub, deploy to Netlify</li>
            <li>• Test on mobile (onboarding often happens on phones/tablets)</li>
            <li>• Fix any responsive issues</li>
          </ul>
          <CopyBlock command="Check all pages for mobile responsiveness. The onboarding app needs to work on phones and tablets. Fix any layout issues — test at 375px, 768px, and 1024px widths." />
        </div>

        <!-- Days 11-12 -->
        <div class="border-l-4 border-purple pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-purple">Days 11–12</span> — IT Automation Scripts</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Read Module 10 (Beyond Code) and the IT department training</li>
            <li>• Write your first automation: a script that checks system health</li>
          </ul>
          <CopyBlock command="Write a bash script that checks: disk usage on all volumes (alert if >85%), whether our key services are responding (list of URLs in services.txt), and last backup timestamp. Output a clean report and send a Slack webhook if anything fails." />
        </div>
      </div>
    </div>

    <!-- Week 3: Power Features -->
    <div class="rounded-xl border border-border bg-background-alt p-5 mt-4">
      <h3 class="font-bold text-lg text-text mb-3">Week 3: Power Features (Days 13–19)</h3>

      <div class="space-y-3">
        <!-- Day 13 -->
        <div class="border-l-4 border-[#00D3DD] pl-4">
          <p class="font-bold text-text"><span class="text-[#00D3DD]">Day 13</span> — Claude Power Features</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Read Module 8 (Claude Power Features)</li>
            <li>• Learn hooks: set up auto-formatting with Prettier</li>
          </ul>
          <CopyBlock command="Create a .claude/settings.json that auto-runs Prettier on every file Claude edits, and blocks dangerous commands like git push --force and rm -rf" />
        </div>

        <!-- Day 14 -->
        <div class="border-l-4 border-[#22c55e] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#22c55e]">Day 14</span> — Onboarding: Add Admin Dashboard</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Admin view showing which new staff have completed which sections</li>
          </ul>
          <CopyBlock command="Add an admin page at /admin that shows all onboarding participants, their completion percentage per section, and overall status. Store data in localStorage for now — we'll add a database later. Include a table with sorting and filtering." />
        </div>

        <!-- Day 15 -->
        <div class="border-l-4 border-[#f59e0b] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f59e0b]">Day 15</span> — Onboarding: Dynamic Content</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Different onboarding paths for different roles</li>
          </ul>
          <CopyBlock command="Add role-based onboarding paths. When a new staff member starts, they select their role: Field Assessor, Office Admin, or Claims Manager. Each role shows different onboarding steps relevant to their position. Field Assessors get vehicle/equipment sections, Office Admin gets systems training, Claims Managers get Pipedrive/CRM setup." />
        </div>

        <!-- Day 16 -->
        <div class="border-l-4 border-[#f472b6] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f472b6]">Day 16</span> — Automation: Account Provisioning Script</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Script that generates new user setup checklists</li>
          </ul>
          <CopyBlock command="Write a Python script that reads new-starters.csv (columns: name, email, role, start_date, manager) and generates: 1. An IT setup checklist customized per role, 2. Email templates for account creation requests (Google Workspace, Pipedrive, etc), 3. A summary for the IT team showing what needs to be set up by when. Output to a new-starter-setup/ folder." />
        </div>

        <!-- Day 17 -->
        <div class="border-l-4 border-purple pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-purple">Day 17</span> — Learn /plan and /loop</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Practice using <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">/plan</code> mode to explore before building</li>
            <li>• Use <code class="bg-text/10 px-1.5 py-0.5 rounded text-xs">/loop</code> to iterate on the onboarding app</li>
          </ul>
          <CopyBlock command="/loop Run the build, check for any TypeScript errors or accessibility warnings, fix them, and keep going until the build is clean" />
        </div>

        <!-- Days 18-19 -->
        <div class="border-l-4 border-[#00D3DD] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#00D3DD]">Days 18–19</span> — Onboarding: Polish & Documentation</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Review for consistency — same card styles, spacing, font sizes</li>
            <li>• Generate documentation for future updates</li>
          </ul>
          <CopyBlock command="Review the entire onboarding app for consistency — same card styles, same spacing, same font sizes across all pages. Then generate a README.md explaining how to add new onboarding steps, how the role-based system works, and how to deploy updates." />
        </div>
      </div>
    </div>

    <!-- Week 4: Advanced & Handoff -->
    <div class="rounded-xl border border-border bg-background-alt p-5 mt-4">
      <h3 class="font-bold text-lg text-text mb-3">Week 4: Advanced & Handoff (Days 20–25)</h3>

      <div class="space-y-3">
        <!-- Day 20 -->
        <div class="border-l-4 border-[#22c55e] pl-4">
          <p class="font-bold text-text"><span class="text-[#22c55e]">Day 20</span> — Onboarding: Add Supabase</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Move from localStorage to a real database</li>
          </ul>
          <CopyBlock command="Migrate the onboarding app from localStorage to Supabase. Create tables for: onboarding_participants (id, name, email, role, start_date, manager), onboarding_progress (participant_id, step_id, completed, completed_at). Set up RLS so participants can only see their own progress. Admin role can see all." />
        </div>

        <!-- Day 21 -->
        <div class="border-l-4 border-[#f59e0b] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f59e0b]">Day 21</span> — Onboarding: Email Notifications</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Automated email when someone completes onboarding</li>
          </ul>
          <CopyBlock command="Add a Supabase Edge Function that sends an email notification to the new starter's manager when all onboarding steps are marked complete. Use Resend or the Supabase email integration." />
        </div>

        <!-- Day 22 -->
        <div class="border-l-4 border-[#f472b6] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#f472b6]">Day 22</span> — IT Monitoring Dashboard</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Build a simple status page for internal services</li>
          </ul>
          <CopyBlock command="Create a new project: rebuild-status-page. An Astro site that pings a list of internal service URLs every 5 minutes (via Netlify scheduled functions), stores uptime data in Supabase, and displays a clean status dashboard. Green = up, Red = down, Yellow = slow (>2s response)." />
        </div>

        <!-- Day 23 -->
        <div class="border-l-4 border-purple pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-purple">Day 23</span> — Documentation Automation</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Use Claude to document existing infrastructure</li>
          </ul>
          <CopyBlock command="Read all config files in this project (docker-compose.yml, nginx configs, .env.example, package.json) and generate a comprehensive infrastructure document: what each service does, which ports it uses, dependencies between services, and how to set up a new dev environment from scratch." />
        </div>

        <!-- Days 24-25 -->
        <div class="border-l-4 border-[#00D3DD] pl-4 mt-3">
          <p class="font-bold text-text"><span class="text-[#00D3DD]">Days 24–25</span> — Review & Plan Next Month</p>
          <ul class="text-sm text-text-secondary mt-1 space-y-1">
            <li>• Review everything built this month</li>
            <li>• Document what worked and what didn't</li>
            <li>• Plan the next iteration of the onboarding app</li>
          </ul>
          <CopyBlock command="Read the entire rebuild-onboarding project and generate: 1. A feature summary of what exists, 2. A list of known issues or rough edges, 3. Recommended improvements for month 2, prioritized by impact. Output as ROADMAP.md" />
        </div>
      </div>
    </div>

    <!-- Summary Card -->
    <div class="rounded-xl border-2 border-purple/30 bg-purple/5 p-5 mt-4">
      <p class="font-bold text-text mb-2">What you'll have built by Day 25</p>
      <ul class="text-sm text-text-secondary space-y-1">
        <li>✓ A fully functional staff onboarding web app with role-based paths, progress tracking, admin dashboard, and Supabase backend</li>
        <li>✓ IT automation scripts for system health checks and account provisioning</li>
        <li>✓ An internal status page for service monitoring</li>
        <li>✓ Infrastructure documentation generated from actual configs</li>
        <li>✓ Confidence to use Claude Code for any IT project going forward</li>
      </ul>
    </div>
  </section>
</MainLayout>
